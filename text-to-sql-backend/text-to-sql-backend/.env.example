# ── AI provider (required for Ask AI / "Generate SQL") ───────────────────────
# Get a key at https://console.groq.com — the SQL editor, schema and table
# browser work without it.
GROQ_API_KEY=gsk_your_key_here

# Ordered fallback chains. If a model errors or is rate-limited the next one is
# tried. The judge defaults to a different model family than the generator so it
# is an independent reviewer. Check `GET /api/query/model-status?deep=true`
# to see whether each configured model currently exists on your account.
# MODEL_CHAIN=llama-3.3-70b-versatile,qwen/qwen3-32b,llama-3.1-8b-instant
# JUDGE_MODEL_CHAIN=qwen/qwen3-32b,llama-3.3-70b-versatile

# ── Query pipeline ───────────────────────────────────────────────────────────
# JUDGE_ENABLED=true            # LLM-as-judge review of every AI answer
# JUDGE_MIN_SCORE=0.7           # below this the answer is flagged / revised
# MAX_JUDGE_REVISIONS=1         # judge-driven regeneration rounds
# MAX_REPAIR_ATTEMPTS=2         # auto-fixes after a guardrail/DB error

# ── Safety limits ────────────────────────────────────────────────────────────
# MAX_ROWS=1000                 # rows returned to the UI per query
# MAX_EXPORT_ROWS=50000         # rows in CSV/Excel/PDF exports
# QUERY_TIMEOUT_SECONDS=20      # per-statement timeout
# MAX_QUESTION_CHARS=1000
# RESTRICTED_COLUMN_PATTERN=    # regex; matching columns are hidden from the AI, blocked in SQL, masked in results

# ── Privacy ──────────────────────────────────────────────────────────────────
# What may be sent to the LLM provider (Groq):
# RESULT_ROWS_TO_LLM=20         # result rows shown to judge + summariser (0 = none)
# LLM_INCLUDE_SAMPLES=true      # sample rows / distinct values in the schema prompt

# ── Server ───────────────────────────────────────────────────────────────────
# CORS_ORIGINS=https://app.example.com   # comma separated; default allows http://localhost:* only
# DATA_DIR=./data               # demo DB + uploaded SQLite files
# HOST=0.0.0.0
# PORT=8000
# DEBUG=false
